generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model FavoritePair {
  id             String    @id @default(cuid())
  baseCurrency   String
  targetCurrency String
  usageCount     Int       @default(0)
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([baseCurrency, targetCurrency])
  @@index([createdAt])
  @@index([usageCount, lastUsedAt])
}

model ConversionHistory {
  id              String   @id @default(cuid())
  baseCurrency    String
  targetCurrency  String
  amount          Float
  convertedAmount Float
  rate            Float
  source          String?
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([baseCurrency, targetCurrency, createdAt])
}
